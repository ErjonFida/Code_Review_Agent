# Copy to .env and fill in. .env is gitignored.

# Fine-grained token scoped to the repository being reviewed, with
# "Pull requests: Read and write".
GITHUB_TOKEN=

# Any long random string. Paste the same value into the webhook's Secret field.
GITHUB_WEBHOOK_SECRET=

# Optional; leave commented out to use the default (llama3.2). An empty value
# here would override the default with nothing.
# REVIEW_MODEL=llama3.2

# Optional; retrieval runs only for diffs at least this many characters long.
# RETRIEVAL_MIN_CHARS=20000
