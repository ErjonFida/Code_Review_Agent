# Copy to .env and fill in. .env is gitignored.

# Fine-grained token scoped to the repository being reviewed, with
# "Pull requests: Read and write".
GITHUB_TOKEN=

# Any long random string. Paste the same value into the webhook's Secret field.
GITHUB_WEBHOOK_SECRET=

# Optional; leave commented out to use the default reviewer, qwen3.5:9b with
# thinking off (needs Ollama >= 0.35.0 and ~16 GB free RAM). An empty REVIEW_MODEL
# would override the default with nothing.
# REVIEW_MODEL=qwen3.5:9b
# REVIEW_THINK=off

# To run the earlier llama3.2 reviewer exactly as it was measured:
# REVIEW_MODEL=llama3.2
# REVIEW_THINK=

# Optional; retrieval runs only for diffs at least this many characters long.
# RETRIEVAL_MIN_CHARS=20000
